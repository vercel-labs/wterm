.{
    .name = .wterm_ghostty,
    .version = "0.0.0",
    .fingerprint = 0xe486cbc71ccad0ae,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // ghostty 1.3.2-dev: includes the hyperlink page-capacity fix
        // (ghostty-org/ghostty#13394) that is not in any tagged release.
        // Same pin zmx 0.7.1 ships with.
        .ghostty = .{
            .path = "ghostty",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
