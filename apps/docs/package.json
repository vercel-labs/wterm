{
  "name": "@wterm/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "mkdir -p public && cp node_modules/@wterm/core/wasm/wterm.wasm public/wterm.wasm && (command -v portless >/dev/null 2>&1 || (echo '\\nportless is required but not installed. Run: npm i -g portless\\nSee: https://github.com/vercel-labs/portless\\n' && exit 1))",
    "dev": "portless docs.wterm next dev --turbopack",
    "prebuild": "mkdir -p public && cp node_modules/@wterm/core/wasm/wterm.wasm public/wterm.wasm",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.161",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@wterm/core": "workspace:*",
    "@wterm/dom": "workspace:*",
    "@wterm/just-bash": "workspace:*",
    "@wterm/markdown": "workspace:*",
    "@wterm/react": "workspace:*",
    "ai": "^6.0.159",
    "bash-tool": "^1.3.16",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "just-bash": "^2.14.2",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
